# === OpenAI (OMA extraction/embeddings and configured evaluation helpers) ===
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# === Google Gemini (default Pedro conversation provider) ===
PEDRO_PROVIDER=gemini
# GEMINI_CHAT_MODEL=your-tested-model-id
GEMINI_API_KEY=your-gemini-api-key-here

# === Anthropic (Pedro + section evaluator; also diagrams) ===
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# Pedro on Claude, with automatic failover to Gemini when Claude is unavailable:
# PEDRO_PROVIDER=anthropic
# ANTHROPIC_PEDRO_MODEL=claude-sonnet-5
# ANTHROPIC_PEDRO_EFFORT=medium
# Section evaluator (writes long-term mastery) — Claude first, then Gemini, then OpenAI:
# ANTHROPIC_EVAL_MODEL=claude-opus-5-5
# ANTHROPIC_EVAL_EFFORT=high
# GEMINI_EVAL_MODEL=gemini-2.5-pro

# === Kimi K2.5 via NVIDIA NIM (optional — alternative for Pedro tutor) ===
# KIMI_API_KEY=nvapi-your-key-here

# === Auth (required for production login) ===
JWT_SECRET=generate-a-long-random-string-here

# Google Sign-In — create OAuth 2.0 Web client at https://console.cloud.google.com/
# Authorized JavaScript origins: http://localhost:5173, https://your-vercel-app.vercel.app
# Authorized redirect URIs: same origins (GIS uses popup, no redirect needed for basic flow)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email verification (Resend) — https://resend.com
RESEND_API_KEY=re_your_resend_key
RESEND_FROM=Coast <onboarding@yourdomain.com>

# Dev only: return verification codes in API response (never enable in production)
# AUTH_DEV_EXPOSE_CODES=true
# Optional: require verify-email before register (off by default — simple signup)
# AUTH_EMAIL_VERIFICATION=true
# Per-process provider admission. Reserve capacity for live Pedro conversations.
COAST_GEMINI_CONCURRENCY=6
COAST_GEMINI_BACKGROUND_CONCURRENCY=4
COAST_OPENAI_CONCURRENCY=6
COAST_OPENAI_BACKGROUND_CONCURRENCY=4
COAST_AI_MAX_WAITERS=64
# Optional request/minute caps: set below your real project quota, divided across processes.
# 0 leaves RPM enforcement to the provider; concurrency limits still apply.
COAST_GEMINI_RPM=0
COAST_OPENAI_RPM=0

# Progressive uploaded-course preparation. Tune alongside provider limits and host memory.
COAST_SOURCE_WORKERS=2
OMA_DOCUMENT_CONCURRENCY=2
# Optional roadmap model override; default remains gemini-3.1-pro-preview.
# GEMINI_OUTLINE_MODEL=your-tested-model-id

# Roadmap fallback uses a separate model from Pedro chat.
OPENAI_OUTLINE_MODEL=gpt-4o-mini
